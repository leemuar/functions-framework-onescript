&BackgroundFunction
Процедура LegacyEventConformance( Данные, Контекст ) Экспорт

	Результат = Новый Соответствие;
	Результат.Вставить( "data", Данные );
	Результат.Вставить( "context", Контекст );

	Запись = Новый ЗаписьJSON();
	Запись.ОткрытьФайл( "function_output.json" );
	ЗаписатьJSON( Запись, Результат );
	Запись.Закрыть();

КонецПроцедуры
